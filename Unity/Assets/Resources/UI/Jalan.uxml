<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Jalan.uss" />
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud hidden" picking-mode="Ignore">
            <ui:VisualElement class="row split top-row" picking-mode="Ignore">
                <ui:VisualElement class="panel objective" picking-mode="Ignore">
                    <ui:Label name="district" class="label kicker" />
                    <ui:Label name="objectiveTitle" class="label subhead objective-title" />
                    <ui:Label name="instruction" class="label objective-copy" />
                    <ui:Label name="detail" class="label objective-detail" />
                </ui:VisualElement>
                <ui:VisualElement class="panel route-panel">
                    <ui:Label name="routeCount" class="label kicker" />
                    <ui:Button name="progress" text="" tooltip="" class="button quiet hud-icon-button i18n-tooltip--text.pause_progress_tab" />
                    <ui:Button name="toggleMissions" text="" class="button quiet hud-action hidden i18n-text--text.choose_mission" />
                    <ui:VisualElement name="missionDrawer" class="hidden">
                        <ui:VisualElement name="steps" class="row route-steps" />
                        <ui:Label name="practiceHint" text="" class="label menu-note i18n-text--text.choose_a_number_to_practice_a_mission" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="signalPanel" class="panel signal-panel hidden" picking-mode="Ignore">
                <ui:Label text="" class="label kicker i18n-text--text.junction_signals_live" />
                <ui:VisualElement class="row signal-views" picking-mode="Ignore">
                    <ui:Image name="signalZoom" class="signal-zoom" picking-mode="Ignore" />
                    <ui:Image name="signalArrowZoom" class="signal-zoom" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="signalMain" class="label signal-state" />
                <ui:Label name="signalRight" class="label signal-state" />
                <ui:Label name="signalHint" class="label signal-hint" />
            </ui:VisualElement>
            <ui:VisualElement name="progressiveCue" class="progressive-cue row hidden" picking-mode="Ignore">
                <ui:Label name="cueKeys" class="label keycap" picking-mode="Ignore" />
                <ui:Label name="cueCopy" class="label cue-copy" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="toast" class="label toast hidden" picking-mode="Ignore" />
            <ui:VisualElement class="row split bottom-row" picking-mode="Ignore">
                <ui:VisualElement class="driving-controls" picking-mode="Ignore">
                    <ui:Label name="hudHint" class="label hud-hint hidden" picking-mode="Ignore" />
                    <ui:VisualElement name="hudControlBar" class="row look-controls" picking-mode="Ignore">
                        <ui:Button name="steeringHelp" tooltip="" class="button quiet hud-icon-button i18n-tooltip--text.steer_a_d_brake_space_controls_f1" />
                        <ui:Button name="cameraControl" tooltip="" class="button quiet hud-icon-button i18n-tooltip--text.change_camera_c" />
                        <ui:Button name="lampControl" tooltip="" class="button quiet hud-icon-button i18n-tooltip--text.motorcycle_headlight_l" />
                        <ui:Button name="lookLeft" text="" tooltip="" class="button quiet hud-icon-button i18n-tooltip--text.hold_to_look_left_z" />
                        <ui:Button name="lookRight" text="" tooltip="" class="button quiet hud-icon-button i18n-tooltip--text.hold_to_look_right_x" />
                    </ui:VisualElement>
                    <ui:Label text="" class="label controls hidden i18n-text--text.w_throttle_space_brake_a_d_steer_q_e" />
                </ui:VisualElement>
                <ui:VisualElement class="panel cluster" picking-mode="Ignore">
                    <ui:Label name="speed" text="0" class="label speed" />
                    <ui:Label text="" class="label unit i18n-text--text.km_h" />
                    <ui:Label name="postedLimit" text="" class="label posted-limit" />
                    <ui:VisualElement name="indicators" class="indicators" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="phone" class="panel phone hidden">
                <ui:Label text="" class="label kicker i18n-text--text.incoming_call" />
                <ui:Label text="" class="label subhead i18n-text--text.mom_is_calling" />
                <ui:Label text="" class="label copy i18n-text--text.ignore_or_stop_in_the_left_bay_before_answering" />
                <ui:VisualElement class="row actions">
                    <ui:Button name="ignorePhone" text="" class="button primary i18n-text--text.ignore_f" />
                    <ui:Button name="answerPhone" text="" class="button quiet i18n-text--text.answer_g" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="pickup" class="panel phone hidden">
                <ui:Label text="" class="label kicker i18n-text--text.market_pickup" />
                <ui:Label text="" class="label subhead i18n-text--text.passenger_waiting" />
                <ui:Label text="" class="label copy i18n-text--text.stop_in_the_left_bay_beside_the_passenger_before" />
                <ui:Button name="pickupPassenger" text="" class="button primary i18n-text--text.pick_up_f" />
            </ui:VisualElement>
            <ui:VisualElement name="demoTutorialCue" class="tutorial-cue-layer hidden" picking-mode="Ignore">
                <ui:VisualElement class="panel tutorial-card" picking-mode="Ignore">
                    <ui:Label name="demoTutorialInstruction" class="label tutorial-instruction" picking-mode="Ignore" />
                    <ui:VisualElement class="tutorial-start-control" picking-mode="Ignore">
                        <ui:Label class="label tutorial-start-copy i18n-text--tutorial.initial.press" picking-mode="Ignore" />
                        <ui:Label text="W" class="label tutorial-start-key" picking-mode="Ignore" />
                        <ui:Label class="label tutorial-start-copy i18n-text--tutorial.initial.drive" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="overlay" class="scrim landing">
            <ui:VisualElement name="dialog" class="panel dialog landing-card" />
            <ui:VisualElement name="vehicleShowroom" class="panel vehicle-showroom hidden" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
