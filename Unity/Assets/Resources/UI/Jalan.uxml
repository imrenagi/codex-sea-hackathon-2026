<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Jalan.uss" />
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud hidden" picking-mode="Ignore">
            <ui:VisualElement class="row split top-row" picking-mode="Ignore">
                <ui:VisualElement class="panel objective" picking-mode="Ignore">
                    <ui:Label name="district" class="label kicker" />
                    <ui:Label name="objectiveTitle" class="label subhead objective-title" />
                    <ui:Label name="instruction" class="label objective-copy" />
                    <ui:Label name="detail" class="label objective-detail" />
                </ui:VisualElement>
                <ui:VisualElement class="panel route-panel">
                    <ui:Label name="routeCount" class="label kicker" />
                    <ui:Button name="progress" text="" tooltip="Pause / progress [Tab]" class="button quiet hud-icon-button" />
                    <ui:Button name="toggleMissions" text="Choose mission" class="button quiet hud-action hidden" />
                    <ui:VisualElement name="missionDrawer" class="hidden">
                        <ui:VisualElement name="steps" class="row route-steps" />
                        <ui:Label name="practiceHint" text="Choose a number to practice a mission" class="label menu-note" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="signalPanel" class="panel signal-panel hidden" picking-mode="Ignore">
                <ui:Label text="JUNCTION SIGNALS · LIVE" class="label kicker" />
                <ui:VisualElement class="row signal-views" picking-mode="Ignore">
                    <ui:Image name="signalZoom" class="signal-zoom" picking-mode="Ignore" />
                    <ui:Image name="signalArrowZoom" class="signal-zoom" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="signalMain" class="label signal-state" />
                <ui:Label name="signalRight" class="label signal-state" />
                <ui:Label name="signalHint" class="label signal-hint" />
            </ui:VisualElement>
            <ui:VisualElement name="progressiveCue" class="progressive-cue row hidden" picking-mode="Ignore">
                <ui:Label name="cueKeys" class="label keycap" picking-mode="Ignore" />
                <ui:Label name="cueCopy" class="label cue-copy" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="toast" class="label toast hidden" picking-mode="Ignore" />
            <ui:VisualElement class="row split bottom-row" picking-mode="Ignore">
                <ui:VisualElement class="driving-controls" picking-mode="Ignore">
                    <ui:Label name="hudHint" class="label hud-hint hidden" picking-mode="Ignore" />
                    <ui:VisualElement name="hudControlBar" class="row look-controls" picking-mode="Ignore">
                        <ui:Button name="steeringHelp" tooltip="Steer A / D · Brake Space · Controls [F1]" class="button quiet hud-icon-button" />
                        <ui:Button name="throttleHelp" tooltip="Throttle: hold W / ↑. Brake: Space / S. [F1 controls]" class="button quiet hud-icon-button" />
                        <ui:Button name="cameraControl" tooltip="Change camera [C]" class="button quiet hud-icon-button" />
                        <ui:Button name="lampControl" tooltip="Motorcycle headlight [L]" class="button quiet hud-icon-button" />
                        <ui:Button name="lookLeft" text="" tooltip="Hold to look left [Z]" class="button quiet hud-icon-button" />
                        <ui:Button name="lookRight" text="" tooltip="Hold to look right [X]" class="button quiet hud-icon-button" />
                    </ui:VisualElement>
                    <ui:Label text="W throttle · Space brake · A / D steer · Q / E indicators · Tab pause" class="label controls hidden" />
                </ui:VisualElement>
                <ui:VisualElement class="panel cluster" picking-mode="Ignore">
                    <ui:Label name="speed" text="0" class="label speed" />
                    <ui:Label text="km/h" class="label unit" />
                    <ui:VisualElement name="indicators" class="indicators" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="phone" class="panel phone hidden">
                <ui:Label text="INCOMING CALL" class="label kicker" />
                <ui:Label text="Mom is calling" class="label subhead" />
                <ui:Label text="Ignore, or stop in the left bay before answering." class="label copy" />
                <ui:VisualElement class="row actions">
                    <ui:Button name="ignorePhone" text="Ignore  [F]" class="button primary" />
                    <ui:Button name="answerPhone" text="Answer  [G]" class="button quiet" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="pickup" class="panel phone hidden">
                <ui:Label text="MARKET PICKUP" class="label kicker" />
                <ui:Label text="Passenger waiting" class="label subhead" />
                <ui:Label text="Stop in the left bay beside the passenger before picking them up." class="label copy" />
                <ui:Button name="pickupPassenger" text="Pick up  [F]" class="button primary" />
            </ui:VisualElement>
            <ui:VisualElement name="demoTutorialCue" class="tutorial-cue-layer hidden" picking-mode="Ignore">
                <ui:VisualElement class="panel tutorial-card" picking-mode="Ignore">
                    <ui:Label name="demoTutorialInstruction" class="label tutorial-instruction" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="overlay" class="scrim landing">
            <ui:VisualElement name="dialog" class="panel dialog landing-card" />
            <ui:VisualElement name="vehicleShowroom" class="panel vehicle-showroom hidden" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
