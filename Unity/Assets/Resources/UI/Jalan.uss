/* RoadSense dusk palette: warm ink, parchment, brass. Signal hues stay semantic. */
.screen {
    --rs-ink: #191e22;
    --rs-raised: #252c30;
    --rs-hover: #333c40;
    --rs-line: #535c5f;
    --rs-text: #eee9df;
    --rs-secondary: #c6c2b8;
    --rs-brass: #c4aa7c;
    --rs-brass-hover: #d4bd94;
    --rs-danger: #e6a59a;
    --rs-success: #a5c3ac;
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Fonts/Manrope/Manrope-Regular.ttf");
    color: var(--rs-text);
    -unity-font-style: normal;
    font-size: 16px;
}
.label { margin: 0; padding: 0; }
.kicker { color: var(--rs-secondary); font-size: 13px; letter-spacing: 1px; -unity-font-style: bold; }
.copy { white-space: normal; font-size: 17px; color: var(--rs-text); margin-top: 7px; }
.hero { font-size: 54px; -unity-font-style: bold; letter-spacing: -1.8px; color: var(--rs-text); }
.heading { font-size: 32px; -unity-font-style: bold; white-space: normal; color: #ffffff; }
.subhead { font-size: 22px; -unity-font-style: bold; white-space: normal; color: #ffffff; }
.row { flex-direction: row; align-items: center; }
.split { justify-content: space-between; }
.panel {
    background-color: rgba(25, 30, 34, 0.94);
    padding: 15px 19px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--rs-line);
}
.hidden { display: none; }
.hud { position: absolute; left: 20px; right: 20px; top: 19px; bottom: 18px; justify-content: space-between; }
.top-row { align-items: flex-start; }
.mirrors { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.mirror { position: absolute; background-color: #15181d; border-width: 2px; border-color: #69665f; border-radius: 8px; overflow: hidden; }
.mirror-left { left: 0; top: 43%; width: 150px; height: 94px; }
.mirror-right { right: 0; top: 43%; width: 150px; height: 94px; }
.mirror-centre { left: 50%; top: 0; width: 190px; height: 70px; translate: -50% 0; }
.mirror-image { flex-grow: 1; scale: -1 1; }
.mirror-caption { position: absolute; left: 0; right: 0; bottom: 0; background-color: rgba(16, 19, 24, 0.7); color: var(--rs-text); font-size: 10px; -unity-text-align: middle-center; padding: 2px; }
.objective { width: 344px; padding: 12px 15px; }
.objective-title { margin-top: 3px; }
.objective-copy { margin-top: 5px; color: var(--rs-text); white-space: normal; font-size: 16px; }
.objective-detail { font-size: 14px; color: #f0cd89; white-space: normal; margin-top: 7px; -unity-font-style: bold; }
.route-panel { width: 220px; flex-shrink: 0; margin-left: 10px; padding: 10px 12px; }
.route-panel .kicker { font-size: 12px; letter-spacing: .7px; white-space: normal; }
.route-steps { flex-wrap: wrap; margin: 10px 0 8px; }
.step {
    width: 44px; height: 44px;
    padding: 0; margin: 0 6px 4px 0;
    border-width: 2px; border-color: #555a62;
    -unity-text-align: middle-center;
    border-radius: 5px;
    background-color: var(--rs-raised); color: var(--rs-secondary);
    -unity-font-style: bold; font-size: 13px;
}
.step:hover { border-color: #ffffff; }
.step:focus { border-color: var(--rs-text); background-color: #555a62; color: #ffffff; }
.step:active { background-color: #555a62; }
.step-current { background-color: var(--rs-text); color: #15181d; }
.step-current:focus { border-color: var(--rs-brass); background-color: var(--rs-text); color: #15181d; }
.step-done { background-color: #235d43; color: #ffffff; }
.bottom-row { align-items: flex-end; }
.driving-controls { flex-shrink: 1; max-width: 420px; margin-right: 12px; }
.look-controls { margin-bottom: 6px; }
.look-button { width: 142px; margin-right: 6px; }
.controls {
    white-space: normal;
    background-color: rgba(25, 30, 34, 0.94);
    color: var(--rs-text); padding: 10px 13px; border-radius: 7px;
    font-size: 14px;
}
.cluster { width: 148px; align-items: center; padding: 10px 12px; border-radius: 6px; flex-shrink: 0; }
.speed { font-size: 48px; color: #ffffff; -unity-font-style: bold; -unity-text-align: middle-center; }
.speed-alert { color: #e5484d; }
.unit { font-size: 13px; color: #a9a6a0; margin-top: -8px; }
.indicators { flex-direction: row; margin-top: 6px; }
.indicators .icon { width: 26px; height: 22px; color: rgba(255,255,255,0.4); margin: 0 5px; }
.indicators .icon.on { color: #52e07f; }
.indicators .icon.lamp.on { color: #8fd0ff; }
.toast {
    position: absolute; top: 90px; left: 50%; translate: -50% 0; width: 46%; max-width: 560px; height: auto; flex-shrink: 0;
    background-color: rgba(16,19,24,.88); color: #ffffff; padding: 9px 14px;
    -unity-font-style: bold; border-radius: 6px; white-space: normal; font-size: 14px;
}
.phone {
    position: absolute; right: 0; bottom: 141px; width: 338px;
    border-color: #e8b21a;
}
.scrim {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center; padding: 18px;
    background-color: rgba(12, 16, 19, 0.58);
}
.landing {
    align-items: flex-start;
    padding-left: 5%;
    background-color: rgba(12, 16, 19, 0.64);
}
.dialog { width: 640px; max-width: 100%; max-height: 100%; min-height: 0; padding: 24px 28px; background-color: rgba(25,30,34,.97); border-color: var(--rs-line); border-radius: 6px; }
.landing-card { background-color: rgba(16, 19, 24, 0.96); padding: 26px 28px; }
.rule-card { border-color: #89675f; }
.section { margin-top: 16px; }
.note {
    background-color: var(--rs-raised); border-radius: 8px; padding: 11px 13px; margin-top: 13px;
}
.note .copy { margin-top: 4px; }
.actions { flex-wrap: wrap; margin-top: 15px; }
.button {
    margin: 3px 7px 3px 0;
    padding: 8px 13px;
    min-height: 44px;
    border-width: 1px; border-color: var(--rs-line); border-radius: 4px;
    color: var(--rs-text); background-color: var(--rs-raised);
    -unity-font-style: bold; -unity-text-align: middle-center;
    white-space: normal; font-size: 15px;
}
.button:hover { background-color: var(--rs-hover); border-color: #89908d; }
.button:focus { border-color: var(--rs-brass); background-color: var(--rs-hover); }
.button:active { background-color: #414b4e; }
.button:disabled { opacity: 0.53; }
.primary { background-color: var(--rs-brass); color: var(--rs-ink); border-color: var(--rs-brass); }
.primary:hover { background-color: var(--rs-brass-hover); border-color: var(--rs-brass-hover); }
.primary:focus { border-color: var(--rs-text); background-color: var(--rs-brass-hover); color: var(--rs-ink); }
.primary:active { background-color: #b69a6d; color: var(--rs-ink); }
.selected { background-color: #3a403a; border-color: var(--rs-brass); color: var(--rs-text); }
.selected:hover { background-color: #464d44; }
.selected:focus { border-color: var(--rs-text); background-color: #464d44; color: var(--rs-text); }
.quiet { background-color: var(--rs-raised); }
.tiny { min-height: 44px; padding: 6px 9px; font-size: 14px; margin: 3px 0 0; }
.option { -unity-text-align: middle-left; margin: 7px 0 0; }
.route-row { padding: 5px 0; }
.route-num { color: #83d8c1; width: 29px; font-size: 13px; -unity-font-style: bold; }
.route-text { font-size: 15px; color: #eef1dc; }
.rule-source { font-size: 13px; margin-top: 11px; color: #f1c79a; white-space: normal; }
.negative { color: #f9ab9b; }
.catalogue-card { width: 780px; height: 94%; max-height: 650px; min-height: 0; overflow: hidden; }
.catalogue-card > .label, .catalogue-footer { flex-shrink: 0; }
.mission-list { height: 340px; min-height: 0; margin-top: 13px; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.mission-list .unity-scroll-view__content-and-vertical-scroll-container { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.mission-list .unity-scroll-view__content-viewport { flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; }
.mission-list .unity-scroll-view__content-container { flex-direction: column; flex-shrink: 0; }
.mission-list .unity-base-slider__dragger { background-color: var(--rs-brass); border-color: var(--rs-brass); }
.vehicle-picker { margin-top: 9px; margin-bottom: 2px; }
.vehicle-choices { flex-direction: row; flex-wrap: wrap; margin-top: 3px; flex-shrink: 0; }
.vehicle-choice { font-size: 14px; min-height: 44px; padding: 7px 10px; flex-shrink: 0; }
.mission-card { background-color: var(--rs-raised); border-radius: 4px; padding: 12px 15px; margin-bottom: 10px; margin-right: 8px; min-height: 132px; flex-shrink: 0; }
.mission-card > .row, .mission-card > .label, .mission-card > .button { flex-shrink: 0; }
.mission-card .mission-title, .mission-card .duration { flex-shrink: 0; }
.mission-title { flex-shrink: 1; }
.duration { margin-left: 12px; flex-shrink: 0; font-size: 12px; }
.route-row { padding: 2px 0; }
.route-num { color: #2fae64; width: 29px; font-size: 13px; -unity-font-style: bold; }
.route-text { font-size: 15px; color: var(--rs-text); }
.rule-source { font-size: 13px; margin-top: 11px; color: var(--rs-secondary); white-space: normal; }
.negative { color: var(--rs-danger); }

/* Keep feedback readable while leaving the next action and recovery controls visible. */
.dialog.result-layout {
    width: 100%; max-height: 100%; padding: 40px 24px 20px;
    align-items: center; background-color: rgba(0,0,0,0); border-width: 0;
}
.result-head { align-items: center; flex-shrink: 0; max-width: 100%; padding-top: 28px; }
.stamp {
    font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center;
    padding: 8px 26px; border-width: 5px; border-radius: 16px;
    letter-spacing: 1px; white-space: nowrap; max-width: 100%;
    rotate: -6deg; margin-bottom: 34px;
    transition-duration: 0.18s; transition-timing-function: ease-out;
}
.stamp.pre { opacity: 0.75; }
.stamp.bad { background-color: #ffe9e6; border-color: #e5484d; color: #e5484d; }
.stamp.good { background-color: #1db45d; border-color: #ffffff; color: #ffffff; }
.stamp.warn { background-color: #563812; border-color: #e8b21a; color: #fff3d5; }
.stamp-caption {
    background-color: rgba(16,19,24,0.92); border-radius: 10px;
    padding: 6px 14px; margin-top: 10px; font-size: 20px;
    -unity-font-style: bold; color: #ffffff; white-space: normal;
    -unity-text-align: middle-center; max-width: 610px;
}
.rise { transition-duration: 0.18s; transition-timing-function: ease-out; }
.rise.pre { opacity: 0.85; translate: 0 8px; }
.sheet {
    background-color: rgba(16,19,24,0.94); border-radius: 16px;
    border-width: 2px; padding: 18px 22px 14px; margin-top: 12px;
    width: 680px; max-width: 100%; flex-shrink: 1; min-height: 0;
}
.sheet.good { border-color: #2fae64; }
.sheet.bad { border-color: #e5484d; }
.sheet.warn { border-color: #ff8a1f; }
.sheet-body { flex-shrink: 1; min-height: 0; }
.sheet-body .unity-scroll-view__content-container > *, .fold-body > * { flex-shrink: 0; }
.sheet-lead { font-size: 17px; color: #ffffff; white-space: normal; margin-bottom: 5px; }
.sheet-text { font-size: 16px; color: var(--rs-text); white-space: normal; margin-top: 2px; }
.result-label { font-size: 13px; color: #c9c1b3; -unity-font-style: bold; margin-top: 12px; margin-bottom: 6px; }
.kind { align-self: flex-start; border-radius: 4px; padding: 4px 8px; font-size: 13px; -unity-font-style: bold; margin-bottom: 10px; }
.kind.legal { background-color: #c4161c; color: #ffffff; }
.kind.advice { background-color: #e8b21a; color: #15181d; }
.sheet-actions { flex-direction: row; flex-wrap: wrap; margin-top: 10px; flex-shrink: 0; }
.button.big { font-size: 16px; min-height: 48px; padding: 10px 13px; border-radius: 8px; flex-grow: 1; border-width: 2px; }
.sheet-actions .primary { flex-grow: 2; }
.result-keys { font-size: 13px; color: #c9c1b3; margin-top: 9px; white-space: normal; flex-shrink: 0; }
.checkpoint-saved { font-size: 13px; color: #7fe0a4; margin-top: 8px; white-space: normal; }
.fold { background-color: rgba(255,255,255,0.05); border-radius: 10px; margin-top: 6px; }
.button.fold-head {
    flex-shrink: 0; flex-direction: row; align-items: center;
    margin: 0; min-height: 44px; padding: 10px 12px; border-width: 2px; border-color: transparent; border-radius: 8px;
    background-color: rgba(255,255,255,0.12); color: #ffffff; font-size: 16px;
    -unity-text-align: middle-left;
}
.fold-title { flex-grow: 1; white-space: normal; }
.fold-sign { font-size: 21px; color: #9a978f; margin-left: 10px; }
.button.fold-head:hover { background-color: rgba(255,255,255,0.2); }
.button.fold-head:focus { border-color: var(--rs-text); background-color: #45474a; }
.fold-body { flex-shrink: 0; display: none; padding: 8px 14px 12px; }
.fold.open > .fold-body { display: flex; }
.sheet .unity-scroller--vertical { width: 8px; margin-left: 8px; }
.sheet .unity-scroller__low-button, .sheet .unity-scroller__high-button { display: none; }
.sheet .unity-base-slider__tracker { background-color: rgba(255,255,255,0.07); border-radius: 4px; }
.sheet .unity-base-slider__dragger { background-color: rgba(255,255,255,0.32); border-radius: 4px; }

/* Bounded menu: all experiences remain keyboard-accessible at smaller windows. */
.landing-card { width: 610px; height: 94%; max-height: 700px; min-height: 0; overflow: hidden; }
.menu-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; }
.menu-scroll .unity-scroll-view__content-viewport { flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; }
.menu-scroll .unity-scroll-view__content-container { flex-shrink: 0; padding-right: 10px; }
.menu-scroll .unity-scroll-view__content-container > * { flex-shrink: 0; }
.city-preview { justify-content: flex-end; align-items: flex-start; background-color: transparent; }
.city-preview .dialog { width: 510px; background-color: rgba(16,19,24,.93); }

.volume-control { margin-top: 10px; min-height: 44px; }
.volume-control .unity-base-field__label { color: var(--rs-text); min-width: 115px; }
.volume-control .unity-base-slider__tracker { background-color: #45474a; }
.volume-control .unity-base-slider__dragger { background-color: var(--rs-text); }

.sheet .rule-source { font-size: 15px; color: #eee8dc; }
.compact .scrim { padding: 10px; }
.compact .dialog { padding: 16px 20px; }
.compact .hero { font-size: 44px; }
.compact .dialog.result-layout { padding: 18px 16px 8px; }
.compact .result-head { padding-top: 20px; }
.compact .stamp { font-size: 42px; border-width: 4px; padding: 6px 18px; margin-bottom: 24px; }
.compact .stamp-caption { margin-top: 7px; font-size: 18px; }
.compact .sheet { margin-top: 12px; padding: 12px 14px 10px; }


.dialog-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: 100%; }
.dialog-scroll .unity-scroll-view__content-container > * { flex-shrink: 0; }
.dialog-scroll .unity-scroller--vertical { width: 8px; margin-left: 8px; }
.dialog-scroll .unity-scroller__low-button, .dialog-scroll .unity-scroller__high-button { display: none; }
.dialog-scroll .unity-base-slider__tracker { background-color: rgba(255,255,255,0.07); border-radius: 4px; }
.dialog-scroll .unity-base-slider__dragger { background-color: rgba(255,255,255,0.32); border-radius: 4px; }

.signal-panel { position: absolute; right: 0; top: 168px; width: 220px; padding: 10px; background-color: rgba(12, 16, 21, 0.97); }
.signal-views { height: 100px; margin-top: 6px; margin-bottom: 6px; }
.signal-zoom { flex-grow: 1; flex-basis: 0; margin-left: 2px; margin-right: 2px; }
.signal-state { font-size: 13px; -unity-font-style: bold; padding: 4px 5px; margin-bottom: 3px; border-radius: 4px; }
.signal-red { background-color: #ff423b; color: #160605; }
.signal-amber { background-color: #ffc137; color: #241700; }
.signal-green { background-color: #32ed7a; color: #062311; }
.signal-hint { font-size: 13px; white-space: normal; color: #ece9e2; margin-top: 5px; }
.penalty { -unity-font-style: bold; color: #ffd18b; }
.legal-note { font-size: 13px; color: #c1c4c9; }

.sheet-body .unity-scroll-view__content-and-vertical-scroll-container { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.sheet-body .unity-scroll-view__content-viewport { overflow: hidden; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.sheet-body .unity-scroll-view__content-container { flex-shrink: 0; }
.sheet-body .unity-scroller__slider { flex-grow: 1; }

/* One clear entry point, with configuration and longer journeys disclosed below it. */
.menu-intro { color: var(--rs-text); font-size: 20px; white-space: normal; margin-top: 2px; margin-bottom: 18px; }
.team-credit { color: var(--rs-secondary); font-size: 14px; margin-top: 4px; margin-bottom: 12px; }
.vehicle-modes { margin-bottom: 10px; }
.button.mode { min-width: 108px; min-height: 44px; margin-top: 0; }
.button.demo-action { min-height: 60px; margin: 0; padding: 12px 18px; font-size: 22px; -unity-text-align: middle-left; }
.demo-summary { font-size: 16px; margin-top: 10px; margin-bottom: 2px; }
.menu-section-title { color: var(--rs-text); font-size: 18px; -unity-font-style: bold; margin-top: 20px; margin-bottom: 7px; }
.practice-paths { flex-wrap: wrap; align-items: stretch; }
.button.practice-action { flex-grow: 1; flex-basis: 44%; min-width: 190px; min-height: 52px; -unity-text-align: middle-left; margin-top: 0; }
.menu-note { color: #c9c1b3; font-size: 14px; white-space: normal; margin-top: 6px; margin-bottom: 8px; }
.button.exit-action { align-self: flex-start; min-width: 100px; margin-top: 12px; }
.button.menu-action { flex-grow: 0; min-width: 90px; }
.sheet-action { font-size: 20px; -unity-font-style: bold; color: var(--rs-text); white-space: normal; margin-bottom: 12px; }
.lesson-explanation { color: #d5d0c6; margin-top: 4px; margin-bottom: 8px; }

/* The mission picker opens deliberately; it never occupies the live signal column. */
.button.hud-action { min-height: 44px; margin: 6px 0 0; padding: 6px 8px; font-size: 14px; }
#missionDrawer {
    position: absolute; right: 232px; top: 132px; width: 292px;
    background-color: var(--rs-ink); border-width: 1px; border-color: #69665f;
    border-radius: 8px; padding: 10px 12px;
}
#missionDrawer .route-steps { margin-top: 0; }
#missionDrawer .menu-note { margin-bottom: 0; }

/* A protected, paused briefing: content can scroll while the start action stays visible. */
.controls-card { width: 920px; height: 92%; max-height: 700px; min-height: 0; overflow: hidden; background-color: var(--rs-ink); }
.controls-card > .label { flex-shrink: 0; }
.controls-intro { max-width: 760px; }
.controls-body { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 16px; overflow: hidden; }
.controls-body .unity-scroll-view__content-and-vertical-scroll-container { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.controls-body .unity-scroll-view__content-viewport { flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; }
.controls-body .unity-scroll-view__content-container { flex-shrink: 0; padding-right: 8px; }
.controls-body .unity-scroll-view__content-container > * { flex-shrink: 0; }
.control-groups { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.control-group { flex-grow: 1; flex-basis: 46%; min-width: 300px; margin-right: 12px; margin-bottom: 18px; }
.control-group > .subhead { font-size: 20px; margin-bottom: 12px; }
.control-title { color: var(--rs-text); font-size: 17px; -unity-font-style: bold; margin-bottom: 3px; white-space: normal; }
.control-row { flex-direction: row; align-items: center; min-height: 48px; margin-bottom: 8px; }
.keycap {
    width: 136px; min-width: 136px; min-height: 46px; max-width: 136px; flex-shrink: 0;
    margin-right: 12px; padding: 7px 10px;
    border-width: 1px; border-bottom-width: 3px; border-color: #66716f; border-radius: 4px;
    background-color: #30383b; color: var(--rs-text); font-size: 20px;
    -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal;
}
.control-description { flex-grow: 1; flex-shrink: 1; min-width: 0; color: var(--rs-text); font-size: 16px; white-space: normal; }
.control-note { color: #d5cbb9; font-size: 15px; white-space: normal; margin-top: 8px; margin-bottom: 10px; }
.control-description .control-note { font-size: 14px; margin: 0; }
.controls-footer { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-items: center; margin-top: 8px; padding-top: 12px; border-top-width: 1px; border-top-color: #55534f; }
.controls-footer .button { min-height: 48px; min-width: 130px; }
.controls-footer .primary { min-width: 240px; min-height: 54px; font-size: 20px; flex-grow: 1; }
.controls-footer .control-note { flex-basis: 100%; margin-top: 8px; margin-bottom: 0; }
.controls-body .unity-scroller--vertical { width: 12px; margin-left: 6px; }
.controls-body .unity-scroller__low-button, .controls-body .unity-scroller__high-button { display: none; }
.controls-body .unity-base-slider__tracker { background-color: var(--rs-raised); border-radius: 5px; }
.controls-body .unity-base-slider__dragger { background-color: #a59b89; border-radius: 5px; }

/* GeometryChangedEvent selects this layout for short or narrow game windows. */
.compact .hud { left: 12px; right: 12px; top: 12px; bottom: 12px; }
.compact .objective { width: 320px; padding: 10px 12px; }
.compact .objective-title { font-size: 21px; }
.compact .objective-copy { font-size: 15px; }
.compact .mirror-left { width: 138px; height: 86px; top: 44%; }
.compact .mirror-right { width: 138px; height: 86px; right: 0; top: 44%; }
.compact .mirror-centre { width: 178px; height: 66px; }
.compact .route-panel { width: 210px; padding: 8px 10px; }
.compact .signal-panel { width: 210px; top: 160px; padding: 8px; }
.compact .signal-views { height: 86px; margin: 4px 0; }
.compact .signal-hint { font-size: 12px; }
.compact .driving-controls { max-width: 380px; }
.compact .controls { font-size: 13px; padding: 8px 10px; }
.compact .cluster { width: 140px; padding: 8px 10px; }
.compact .speed { font-size: 44px; }
.compact .toast { top: 82px; width: 46%; max-width: 520px; font-size: 13px; }
.compact #missionDrawer { right: 222px; top: 126px; }
.compact .menu-intro { font-size: 18px; margin-bottom: 12px; }
.compact .button.demo-action { min-height: 54px; font-size: 20px; }
.compact .menu-section-title { margin-top: 16px; }
.compact .controls-card { height: 96%; padding: 16px 20px; }
.compact .controls-card .heading { font-size: 29px; }
.compact .controls-body { margin-top: 10px; }
.compact .control-group { margin-bottom: 12px; }
.compact .control-group > .subhead { font-size: 19px; margin-bottom: 10px; }
.compact .controls-footer { padding-top: 8px; margin-top: 6px; }

/* Open title composition over the live street; navigation is the only accent. */
.landing-card {
    width: 510px; height: auto; max-height: 94%; padding: 24px 0;
    background-color: transparent; border-width: 0; border-radius: 0;
}
.home-wordmark { font-size: 72px; letter-spacing: -2px; color: var(--rs-text); }
.home-tagline { font-size: 19px; white-space: normal; color: var(--rs-text); margin-top: 10px; max-width: 420px; }
.home-actions { margin-top: 36px; width: 300px; max-width: 100%; }
.home-action { min-height: 56px; margin: 0 0 10px; font-size: 22px; -unity-text-align: middle-left; padding-left: 18px; border-radius: 3px; }
.home-action.quiet { background-color: rgba(25,30,34,.42); border-color: transparent; border-bottom-color: #6b706b; -unity-font-style: normal; }
.home-action.quiet:hover { background-color: rgba(51,60,64,.9); border-color: #89908d; }
.home-action.quiet:focus { background-color: rgba(51,60,64,.9); border-color: var(--rs-brass); }
.landing-card .team-credit { margin-top: 16px; margin-bottom: 0; color: var(--rs-brass-hover); letter-spacing: .5px; }
.play-card { width: 640px; height: 94%; max-height: 740px; overflow: hidden; }
.dialog.play-card { padding: 28px 32px; }
.options-card { width: 580px; height: 80%; max-height: 580px; overflow: hidden; }
.menu-scroll .unity-scroll-view__content-and-vertical-scroll-container { flex-grow: 1; flex-shrink: 1; min-height: 0; }

/* Driving gets one action and essential safety status; help appears on demand. */
#district, #objectiveTitle, #routeCount, #toggleMissions, #missionDrawer, .controls { display: none; }
.objective { width: 340px; padding: 10px 14px; }
.objective-copy { margin-top: 0; font-size: 18px; -unity-font-style: bold; }
.objective-detail { margin-top: 6px; font-size: 15px; }
.route-panel { width: 56px; padding: 0; margin-left: 12px; background-color: transparent; border-width: 0; }
.driving-controls { max-width: 440px; }
.look-controls { margin-bottom: 0; flex-wrap: wrap; }
.button.hud-icon-button {
    width: 54px; height: 54px; min-width: 54px; min-height: 54px;
    padding: 10px; margin: 0 6px 4px 0; align-items: center; justify-content: center;
    background-color: rgba(16,19,24,.94); color: var(--rs-text); border-color: #8a867e;
}
.button.hud-icon-button:hover, .button.hud-icon-button:focus { background-color: #45474a; border-color: #ffffff; }
.driving-glyph { width: 28px; height: 28px; flex-shrink: 0; color: var(--rs-text); }
.hud-hint {
    position: absolute; left: 0; bottom: 72px; width: 100%; max-width: 430px; height: auto; flex-shrink: 0;
    background-color: rgba(16,19,24,.88); color: #ffffff; padding: 9px 12px; border-radius: 6px;
    font-size: 16px; white-space: normal; -unity-font-style: bold;
}
.signal-panel { top: 76px; }
.indicators .icon { color: var(--rs-secondary); }
.unit { color: #d5cbb9; }
.compact .landing-card { width: 430px; padding: 18px 0; }
.compact .home-wordmark { font-size: 60px; }
.compact .home-tagline { font-size: 17px; }
.compact .home-actions { margin-top: 26px; width: 270px; }
.compact .home-action { min-height: 48px; margin-bottom: 8px; }
.compact .route-panel { width: 54px; padding: 0; }
.compact .signal-panel { top: 74px; }
.compact .objective-copy { font-size: 17px; }
.compact .driving-controls { max-width: 380px; }
.control-description .driving-glyph { width: 22px; height: 22px; margin-right: 8px; }

/* One contextual cue; the complete paused guide stays behind F1. */
.progressive-cue { position: absolute; left: 0; bottom: 76px; width: 430px; max-width: 100%; padding: 10px 12px; background-color: rgba(16,19,24,.94); border-radius: 8px; }
.progressive-cue .keycap { width: 126px; min-width: 126px; max-width: 126px; min-height: 40px; font-size: 18px; margin-right: 12px; }
.cue-copy { font-size: 17px; color: var(--rs-text); white-space: normal; flex-grow: 1; flex-shrink: 1; min-width: 0; }

/* Demo messages stay in the upper-left corner, clear of the crossing. */
.tutorial-cue-layer {
    position: absolute; left: 0; right: 0; top: 0;
    align-items: flex-start; justify-content: flex-start;
}
.scrim.tutorial-overlay {
    align-items: flex-start; justify-content: flex-start; background-color: rgba(0,0,0,0);
}
.tutorial-card {
    width: 420px; max-width: 78%; height: auto; padding: 10px 16px;
    background-color: rgba(16,19,24,.88); border-color: #555b63; border-radius: 6px;
}
.tutorial-card .kicker { -unity-text-align: middle-left; margin-bottom: 4px; }
.tutorial-instruction {
    font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-left;
    white-space: normal; color: #ffffff;
}
.demo-guided .objective, .demo-guided .toast, .demo-guided .hud-hint,
.demo-guided .progressive-cue, .demo-guided .controls { display: none; }
.demo-feedback .objective { display: none; }
.demo-feedback .toast { top: 0; left: 0; align-self: flex-start; }
.compact .tutorial-instruction { font-size: 18px; }
.compact .tutorial-card { padding: 10px 14px; }

/* The first action is a legible lower-center prompt; hazards stay top-left. */
.tutorial-cue-layer.tutorial-initial { top: 60%; align-items: center; }
.tutorial-initial .tutorial-card {
    width: auto; max-width: 92%; padding: 14px 22px;
    border-width: 1px; border-color: rgba(255,255,255,.18); border-radius: 8px;
    background-color: rgba(0,0,0,.78);
}
.tutorial-start-control { display: none; }
.tutorial-initial .tutorial-instruction { display: none; }
.tutorial-initial .tutorial-start-control { display: flex; flex-direction: row; align-items: center; justify-content: center; }
.tutorial-start-copy { font-size: 24px; color: #ffffff; white-space: normal; -unity-font-style: bold; }
.tutorial-start-key {
    width: 48px; min-width: 48px; height: 48px; margin: 0 12px;
    background-color: #646a70; color: #ffffff; border-radius: 6px;
    border-width: 1px; border-bottom-width: 4px; border-color: #b5bcc3;
    font-size: 25px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.compact .tutorial-start-copy { font-size: 22px; }
.compact .tutorial-initial .tutorial-card { padding: 12px 18px; }

/* Vehicle chooser: one journey action, optional activities disclosed below. */
.chooser-vehicles { align-items: stretch; margin: 24px -8px 0; }
.button.chooser-vehicle {
    flex-direction: column; flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 164px;
    margin: 0 8px; padding: 20px; align-items: flex-start;
    background-color: var(--rs-raised); border-width: 1px; border-color: var(--rs-line); border-radius: 6px;
    white-space: normal;
}
.button.chooser-vehicle.selected { background-color: #393d35; border-color: var(--rs-brass); }
.button.chooser-vehicle:hover, .button.chooser-vehicle:focus { border-color: var(--rs-brass); background-color: var(--rs-hover); }
.chooser-vehicle .driving-glyph { width: 64px; height: 64px; margin-bottom: 16px; }
.chooser-selection { font-size: 11px; color: #d5cbb9; letter-spacing: 1px; }
.chooser-vehicle-title { font-size: 25px; -unity-font-style: bold; color: #ffffff; margin-top: 8px; white-space: normal; }
.chooser-vehicle-note { font-size: 14px; color: #d5cbb9; white-space: normal; margin-top: 5px; }
.chooser-summary { margin-top: 24px; margin-bottom: 16px; }
.button.chooser-start { min-height: 56px; font-size: 21px; margin: 0 0 24px; padding: 12px 20px; }
.play-card .menu-scroll .unity-scroll-view__content-container { padding-right: 4px; padding-bottom: 4px; }
.play-card .fold { margin-top: 0; }
.play-card .fold-body { padding: 16px; }
.play-card .fold-body .option { margin-top: 12px; padding: 10px 14px; }
.play-card .fold-body .fold { margin-top: 20px; }
.play-card .menu-note { margin-top: 12px; margin-bottom: 12px; }
.play-card .button.exit-action { margin-top: 24px; margin-bottom: 0; }
.compact .dialog.play-card { padding: 20px 24px; }
.compact .button.chooser-vehicle { min-height: 156px; padding: 16px; }
.compact .chooser-vehicles { margin-top: 20px; }
.compact .chooser-summary { margin-top: 20px; margin-bottom: 12px; }
.compact .button.chooser-start { margin-bottom: 20px; }
.compact .play-card .button.exit-action { margin-top: 20px; }

.dialog.landing-card { background-color: transparent; border-width: 0; border-radius: 0; }
.kind { border-radius: 3px; padding: 4px 7px; font-size: 12px; }
.kind.legal { background-color: #46322e; color: #edb7ac; }
.kind.advice { background-color: #453c2d; color: #e3c899; }
.sheet-action { font-size: 21px; margin-bottom: 10px; }
.sheet-text, .sheet-lead { color: var(--rs-text); }
.sheet .rule-source { font-size: 14px; color: var(--rs-secondary); }
.result-label, .result-keys { color: var(--rs-secondary); }
.checkpoint-saved { color: var(--rs-success); }
.fold { background-color: transparent; border-radius: 4px; }
.button.fold-head { background-color: var(--rs-raised); border-width: 1px; border-radius: 4px; color: var(--rs-text); }
.button.fold-head:hover { background-color: var(--rs-hover); }
.button.fold-head:focus { background-color: var(--rs-hover); border-color: var(--rs-brass); }
.fold-body { padding: 10px 12px 14px; }
.button.big { border-width: 1px; border-radius: 4px; }
.sheet-actions { margin-top: 16px; }

/* Preserve the upstream interactive vehicle showroom. */
.mission-list .unity-scroller__slider { flex-grow: 1; }

.showroom { flex-direction: row; align-items: center; justify-content: center; }
.showroom > .dialog { flex-grow: 1; flex-basis: 0; min-width: 0; max-width: 620px; }
.vehicle-showroom { flex-grow: 1; flex-basis: 0; min-width: 0; max-width: 520px; height: 94%; max-height: 680px; margin-left: 24px; padding: 24px; background-color: #13171c; }
.vehicle-showroom > .label, .vehicle-showroom > .row, .vehicle-showroom > .vehicle-choices, .preview-angle { flex-shrink: 0; }
.vehicle-preview { flex-grow: 1; flex-shrink: 1; min-height: 80px; margin: 8px 0; }
.vehicle-preview:focus { border-width: 1px; border-color: #85dcc5; }
.preview-hint { font-size: 12px; white-space: normal; color: #c9c6be; }
.preview-controls { flex-wrap: wrap; margin: 12px -4px 8px; }
.preview-controls > .button { flex-grow: 1; margin: 0 4px 8px; }
.vehicle-showroom .vehicle-choice { margin: 4px 8px 4px 0; }
.preview-angle .unity-base-field__label { min-width: 44px; }
.compact .vehicle-showroom { padding: 16px; margin-left: 16px; }
.compact .vehicle-showroom .subhead { font-size: 18px; }
.compact .vehicle-showroom .vehicle-choice { font-size: 12px; padding: 8px 10px; min-height: 44px; }

/* Home-only contrast panel keeps scenery from competing with menu text. */
.landing .dialog.landing-card {
    background-color: rgba(0,0,0,.84); padding: 24px 28px;
    border-width: 1px; border-color: rgba(255,255,255,.12); border-radius: 6px;
}
.landing .home-wordmark, .landing .home-tagline { color: #ffffff; }
.landing .home-tagline { opacity: 1; }
.landing .team-credit { color: #e6d3af; }
.compact .landing .dialog.landing-card { padding: 20px 24px; }

/* Home navigation shares one palette; Play leads through position and weight. */
.landing .home-action.primary {
    background-color: rgba(25,30,34,.42); color: var(--rs-text);
    border-color: transparent; border-bottom-color: #6b706b;
}
.landing .home-action.primary:hover {
    background-color: rgba(51,60,64,.9); border-color: #89908d; color: var(--rs-text);
}
.landing .home-action.primary:focus {
    background-color: rgba(51,60,64,.9); border-color: var(--rs-brass); color: var(--rs-text);
}
.landing .home-action.primary:active { background-color: #414b4e; color: var(--rs-text); }

/* Credits use the existing warm dialog surface and a quiet team roster. */
.dialog.credits-card { width: 580px; max-height: 94%; padding: 28px 32px; }
.credits-team { margin-top: 24px; padding-top: 20px; border-top-width: 1px; border-color: var(--rs-line); }
.credits-team-name { color: var(--rs-brass-hover); font-size: 30px; margin-top: 7px; margin-bottom: 16px; }
.credits-person { color: var(--rs-text); font-size: 21px; white-space: normal; margin-bottom: 10px; }
.credits-actions { margin-top: 22px; }
.credits-actions .button { margin-right: 0; min-height: 48px; }
.credits-actions .credits-explore { font-size: 19px; margin-bottom: 8px; }
.compact .dialog.credits-card { padding: 20px 24px; }
.compact .credits-team { margin-top: 18px; padding-top: 16px; }
.compact .credits-person { font-size: 19px; margin-bottom: 8px; }
.compact .credits-actions { margin-top: 16px; }

/* Static Manrope faces use Unity's normal TrueType importer and TextCore bridge. */
.screen .hero, .screen .heading, .screen .subhead, .screen .kicker,
.screen .control-title, .screen .chooser-vehicle-title, .screen .speed {
    -unity-font-definition: url("project://database/Assets/Fonts/Manrope/Manrope-SemiBold.ttf");
    -unity-font-style: normal;
}

/* Generated key face; the UI retains crisp real text for W/A/S/D and arrows. */
.keyboard-keycap {
    width: 48px; min-width: 48px; height: 48px; flex-shrink: 0;
    font-size: 25px; -unity-text-align: middle-center;
}
.keyboard-keycap, .tutorial-start-key {
    background-image: url("project://database/Assets/Resources/UI/Keycaps/KeyboardKeycap.png");
    background-size: 130% 130%;
    background-position: center;
    background-repeat: no-repeat;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
    color: #20272b;
    -unity-font-definition: url("project://database/Assets/Fonts/Manrope/Manrope-SemiBold.ttf");
    -unity-font-style: normal;
    padding-bottom: 4px;
}

.play-card .explore-actions > * { flex-shrink: 0; }
.play-card .explore-actions .option { margin-top: 12px; }


/* Compact driving HUD: roughly half the occupied area (~70% linear size).
   Scoped to #hud so chooser, feedback, controls guide and tutorial remain readable.
   Explicit geometry rather than root scaling keeps edge anchors and hit targets correct. */
#hud { left: 12px; right: 12px; top: 12px; bottom: 12px; }
#hud .mirror { border-width: 1px; border-radius: 5px; }
#hud .mirror-left, #hud .mirror-right { width: 106px; height: 66px; top: 43%; }
#hud .mirror-centre { width: 134px; height: 50px; }
#hud .mirror-caption { font-size: 9px; padding: 1px; }
#hud .objective { width: 250px; padding: 7px 10px; border-radius: 4px; }
#hud .objective-copy { font-size: 14px; margin-top: 0; }
#hud .objective-detail { font-size: 12px; margin-top: 4px; }
#hud .route-panel { width: 38px; margin-left: 8px; padding: 0; }
#hud .driving-controls { max-width: 310px; margin-right: 8px; }
#hud .button.hud-icon-button {
    width: 38px; height: 38px; min-width: 38px; min-height: 38px;
    padding: 7px; margin: 0 4px 2px 0; border-radius: 4px;
}
#hud .driving-glyph { width: 20px; height: 20px; }
#hud .cluster { width: 104px; padding: 6px 8px; border-radius: 4px; }
#hud .speed { font-size: 34px; }
#hud .unit { font-size: 11px; margin-top: -5px; }
#hud .indicators { margin-top: 4px; }
#hud .indicators .icon { width: 18px; height: 16px; margin: 0 3px; }
#hud .hud-hint { bottom: 48px; max-width: 310px; padding: 6px 8px; font-size: 13px; border-radius: 4px; }
#hud .progressive-cue { bottom: 52px; max-width: 330px; padding: 7px 9px; border-radius: 5px; }
#hud .progressive-cue .keycap { width: 88px; min-width: 88px; max-width: 88px; min-height: 30px; font-size: 14px; margin-right: 8px; }
#hud .cue-copy { font-size: 14px; }
#hud .signal-panel { top: 54px; width: 164px; padding: 7px; }
#hud .signal-views { height: 70px; margin-top: 4px; margin-bottom: 4px; }
#hud .signal-state { font-size: 12px; padding: 3px 4px; margin-bottom: 2px; }
#hud .signal-hint { font-size: 12px; margin-top: 3px; }
#hud .signal-panel .kicker { font-size: 10px; letter-spacing: .5px; }
#hud .toast { top: 62px; width: 330px; min-height: 32px; padding: 7px 10px; font-size: 14px; border-radius: 4px; }
#hud.demo-feedback .toast { top: 0; }
#hud .phone { bottom: 106px; width: 270px; padding: 10px 12px; }
#hud .phone .kicker { font-size: 11px; }
#hud .phone .subhead { font-size: 16px; }
#hud .phone .copy { font-size: 13px; }
#hud .phone .button { min-height: 34px; padding: 6px 8px; font-size: 13px; }


/* Lighter controls and slim scroll rails. Preserve keyboard focus and generous
   desktop click targets without thick frames or oversized vertical padding. */
.screen .button {
    min-height: 40px; padding: 6px 12px; margin: 3px 6px 3px 0;
    border-width: 1px; border-radius: 6px; border-color: rgba(238,233,223,.18);
    background-color: #282f33; color: var(--rs-text); font-size: 15px;
    -unity-font-style: normal;
}
.screen .button:hover { background-color: #343e42; border-color: rgba(238,233,223,.4); }
.screen .button:focus { border-color: var(--rs-brass-hover); background-color: #343e42; }
.screen .button:active { background-color: #414b4e; }
.screen .button.primary { background-color: var(--rs-brass); color: var(--rs-ink); border-color: transparent; }
.screen .button.primary:hover { background-color: var(--rs-brass-hover); }
.screen .button.primary:focus { background-color: var(--rs-brass-hover); border-color: #ffffff; }
.screen .button.primary:active { background-color: #b69a6d; }
.screen .button.quiet { background-color: rgba(25,30,34,.3); border-color: rgba(238,233,223,.12); }
.screen .button.quiet:hover, .screen .button.quiet:focus { background-color: #303a3e; border-color: var(--rs-brass); }
.screen .button.selected { background-color: #343d37; border-color: var(--rs-brass); }
.screen .button.selected:focus { border-color: #ffffff; }
.screen .button.big, .screen .button.demo-action, .screen .button.chooser-start,
.screen .controls-footer .button { min-height: 44px; padding: 8px 14px; font-size: 16px; }
.screen .button.chooser-start { margin-bottom: 16px; }
.screen .button.home-action { min-height: 44px; font-size: 19px; margin-bottom: 7px; -unity-text-align: middle-left; padding-left: 14px; }
.screen .button.fold-head { min-height: 40px; padding: 6px 10px; margin: 0; font-size: 15px; background-color: rgba(255,255,255,.025); }
.screen .button.practice-action { min-height: 44px; }
.screen .button.chooser-vehicle { min-height: 132px; padding: 14px; margin: 0 6px; }
.screen .chooser-vehicle .driving-glyph { width: 48px; height: 48px; margin-bottom: 10px; }
.screen .chooser-vehicle-title { font-size: 22px; margin-top: 6px; }
.screen .chooser-vehicle-note { font-size: 13px; }
.screen .button.vehicle-choice { min-height: 40px; padding: 6px 10px; font-size: 14px; }
.screen .play-card .fold-body .option { padding: 6px 10px; margin-top: 8px; }
.screen .button.city-selection-card { padding: 0 0 10px; margin: 0 9px 12px 0; }

/* Scroller-only selectors do not affect the volume sliders. The rail retains
   a 12px draggable lane; its visible thumb is only 6px, with no arrow buttons. */
.screen .unity-scroller { background-color: transparent; border-width: 0; }
.screen .unity-scroller--vertical { width: 12px; min-width: 12px; margin-left: 4px; }
.screen .unity-scroller--horizontal { height: 12px; min-height: 12px; margin-top: 4px; }
.screen .unity-scroller .unity-scroller__low-button,
.screen .unity-scroller .unity-scroller__high-button { display: none; }
.screen .unity-scroller .unity-scroller__slider { margin: 0; padding: 0; background-color: transparent; border-width: 0; }
.screen .unity-scroller .unity-base-slider__tracker { background-color: rgba(238,233,223,.04); border-width: 0; border-radius: 3px; }
.screen .unity-scroller .unity-base-slider__dragger { background-color: rgba(198,194,184,.42); border-width: 0; border-radius: 3px; }
.screen .unity-scroller--vertical .unity-base-slider__dragger { width: 6px; min-width: 6px; margin-left: 3px; margin-right: 3px; }
.screen .unity-scroller--horizontal .unity-base-slider__dragger { height: 6px; min-height: 6px; margin-top: 3px; margin-bottom: 3px; }
.screen .unity-scroller .unity-base-slider__dragger:hover,
.screen .unity-scroller .unity-base-slider__dragger:active { background-color: var(--rs-brass-hover); }
.screen .unity-scroller:focus .unity-base-slider__dragger { background-color: var(--rs-brass-hover); }


/* Side-profile vehicle picker: actual vehicle art, compact wrapping cards.
   The button retains its semantic name/tooltip; no visible model-name label. */
.screen .button.vehicle-thumbnail-choice {
    width: 120px; min-width: 120px; max-width: 120px;
    height: 72px; min-height: 72px; max-height: 72px;
    flex-grow: 0; flex-shrink: 0; flex-basis: 120px;
    padding: 4px; margin: 0 8px 8px 0;
    align-items: center; justify-content: center;
    border-width: 2px; border-radius: 6px;
    border-color: rgba(238,233,223,.16); background-color: #20282d;
    font-size: 0; overflow: hidden;
}
.screen .vehicle-thumbnail-choice .vehicle-choice-image {
    width: 100%; height: 60px; flex-grow: 0; flex-shrink: 0;
    margin: 0; padding: 0;
}
.screen .button.vehicle-thumbnail-choice:hover { border-color: #a59b89; background-color: #303b40; }
.screen .button.vehicle-thumbnail-choice.selected { border-color: var(--rs-brass); background-color: #3b443b; }
.screen .button.vehicle-thumbnail-choice:focus { border-color: #ffffff; background-color: #354148; }
.screen .button.vehicle-thumbnail-choice:active { background-color: #46524c; }
.screen .button.vehicle-thumbnail-choice:disabled { opacity: .45; }


/* Keep vehicle-mode cards inside the scroll viewport. The old -8px row
   margins outgrew the new 6px card margins and clipped the left Car edge. */
.screen .chooser-vehicles { margin-left: 0; margin-right: 0; min-width: 0; }
.screen .chooser-vehicles > .button.chooser-vehicle { margin-left: 0; margin-right: 8px; }
.screen .chooser-vehicles > .button.chooser-vehicle:last-child { margin-right: 0; }


/* Centered game home: transparent title over the live street, with a calm
   vertical navigation stack. Only the home changes; dialogs stay unchanged. */
.screen .landing {
    align-items: center; justify-content: center; padding: 18px;
    background-color: rgba(9,15,19,.38);
}
.screen .landing .dialog.landing-card {
    width: 720px; max-width: 100%; height: auto; max-height: 96%;
    padding: 12px 20px; align-items: center;
    background-color: transparent; border-width: 0; border-radius: 0;
}
.screen .landing .home-logo {
    width: 620px; max-width: 100%; height: 155px; min-height: 0;
    flex-shrink: 1; margin: 0; padding: 0;
}
.screen .landing .home-wordmark {
    -unity-text-align: middle-center; color: #ffffff; font-size: 72px;
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(7,13,17,.95);
}
.screen .landing .home-tagline {
    max-width: 560px; margin-top: 8px; font-size: 17px;
    -unity-text-align: middle-center; color: #ffffff;
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(7,13,17,.9);
}
.screen .landing .home-actions { width: 320px; max-width: 100%; margin-top: 24px; }
.screen .landing .button.home-action {
    width: 100%; min-height: 44px; margin: 0 0 7px; padding: 7px 16px;
    -unity-text-align: middle-center; font-size: 17px; border-radius: 5px;
    border-width: 1px; border-color: rgba(238,233,223,.22);
    background-color: rgba(21,29,34,.86); color: #eee9df;
}
.screen .landing .button.home-action.primary { background-color: #c4aa7c; color: #191e22; border-color: #d4bd94; }
.screen .landing .button.home-action:hover { background-color: #35434a; border-color: #d4bd94; color: #ffffff; }
.screen .landing .button.home-action.primary:hover { background-color: #d4bd94; color: #191e22; }
.screen .landing .button.home-action:focus { border-color: #ffffff; background-color: #35434a; color: #ffffff; }
.screen .landing .button.home-action.primary:focus { background-color: #d4bd94; color: #191e22; }
.screen .landing .button.home-action:active { background-color: #4a554f; }
.screen .landing .button.home-action.primary:active { background-color: #b69a6d; color: #191e22; }
.screen.compact .landing .dialog.landing-card { padding: 8px 12px; }
.screen.compact .landing .home-logo { width: 480px; height: 120px; }
.screen.compact .landing .home-wordmark { font-size: 56px; }
.screen.compact .landing .home-tagline { font-size: 15px; margin-top: 4px; }
.screen.compact .landing .home-actions { width: 300px; margin-top: 18px; }
.screen.compact .landing .button.home-action { min-height: 40px; font-size: 16px; margin-bottom: 6px; }


/* Keep the subtitle legible over bright roads and changing menu camera shots.
   A small backing belongs to the subtitle only; the wordmark stays transparent. */
.screen .landing .home-tagline {
    padding: 7px 14px; border-radius: 5px; background-color: rgba(8,14,18,.88);
    color: #ffffff; font-size: 18px; -unity-font-style: bold;
    -unity-text-outline-width: 0; margin-top: 10px;
    flex-shrink: 0; white-space: normal;
}
.screen.compact .landing .home-tagline { font-size: 16px; padding: 6px 12px; margin-top: 6px; }

.posted-limit { font-size: 11px; color: #ffffff; -unity-text-align: middle-center; white-space: normal; flex-shrink: 0; }
.posted-warning { color: #ffb45c; -unity-font-style: bold; }

/* Soften moving home scenery without flattening the transparent wordmark. */
.screen .landing { background-color: rgba(18,25,30,.54); }
